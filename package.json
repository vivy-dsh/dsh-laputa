{
  "name": "dsh-laputa",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "description": "DeepSeek Harness persona plugin: inject user-authored persona Markdown, guide first-run setup through a create-only tool, and edit the six documents from a same-level management panel.",
  "keywords": [
    "deepseek-harness",
    "plugin",
    "persona",
    "system-prompt",
    "laputa"
  ],
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/types/**/*",
    "src/client.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProjectViVy/laputa.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.2.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.1 <0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.80.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
